<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="trypost_test"/>
        <env name="DB_PASSWORD" value="password"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SOCIALHQ_AI_GATEWAY" value="direct"/>
        <env name="SOCIALHQ_AI_APPROVED_PROVIDERS" value="openai,anthropic,gemini"/>
        <!-- Social HQ: upstream tests expect TryPost's own approval rules; ours switch them on. -->
        <env name="SOCIALHQ_MEMBERS_ALWAYS_REVIEWED" value="false"/>
        <env name="SOCIALHQ_AGENT_POSTS_REVIEWED" value="false"/>
        <!-- Social HQ: upstream browser tests publish at once without our confirmation; ours switch it on. -->
        <env name="SOCIALHQ_PUBLISH_NOW_CONFIRM" value="false"/>
        <!-- Social HQ: upstream browser tests expect the calendar's side panel closed and on its drafts; ours opens by itself. -->
        <env name="SOCIALHQ_CALENDAR_POST_LIST_OPEN" value="false"/>
        <!-- Social HQ: upstream tests manage API keys and webhooks through MCP and API keys; ours switch this off. -->
        <env name="SOCIALHQ_AGENTS_MANAGE_ADMIN_SETTINGS" value="true"/>
        <!-- Social HQ: upstream tests register and create workspaces without companies; ours switch these on. -->
        <env name="SOCIALHQ_COMPANY_REQUESTS" value="false"/>
        <env name="SOCIALHQ_COMPANIES_REQUIRED" value="false"/>
        <!-- Social HQ: upstream tests connect networks without every OAuth app set; ours switch this on. -->
        <env name="SOCIALHQ_CHANNELS_REQUIRE_CREDENTIALS" value="false"/>
        <!-- Social HQ: upstream tests check TryPost's Horizon supervisors; ours fold them into three. -->
        <env name="SOCIALHQ_HORIZON_COMPACT" value="false"/>
    </php>
</phpunit>
